[Unit]
Description=DcarAIGC read-replica web
After=network-online.target dcar-api.service
Wants=network-online.target dcar-api.service
ConditionPathIsDirectory=/var/www/dcar-aigc/current/app/web/dist

[Service]
Type=simple
User=dcar-aigc
Group=dcar-aigc
WorkingDirectory=/var/www/dcar-aigc/current/app/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=WRANGLER_WRITE_LOGS=false
Environment=WRANGLER_LOG_PATH=/tmp/dcar-wrangler.log
Environment=MINIFLARE_REGISTRY_PATH=/tmp/dcar-miniflare-registry
Environment=DCAR_READ_ONLY=1
Environment=DCAR_THUMBNAIL_PYTHON=/var/www/dcar-aigc/current/.venv/bin/python
Environment=DCAR_THUMBNAIL_HELPER=/var/www/dcar-aigc/current/app/web/server/content_thumbnails.py
Environment=DCAR_THUMBNAIL_DB=/var/lib/dcar-aigc/db/dcar_insight.sqlite3
Environment=DCAR_THUMBNAIL_PROJECT_ROOT=/var/www/dcar-aigc/current
ExecStart=/var/www/dcar-aigc/runtime/node-v22.13.1-linux-x64/bin/node ./node_modules/vinext/dist/cli.js start --hostname 127.0.0.1 --port 4174
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

BindReadOnlyPaths=/var/lib/dcar-aigc/cache:/var/www/dcar-aigc/current/data/cache
ReadOnlyPaths=/var/lib/dcar-aigc/db /var/lib/dcar-aigc/cache
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

CPUQuota=100%
MemoryMax=1G
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
