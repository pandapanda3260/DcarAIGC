[Unit]
Description=DcarAIGC phase-1 web
After=network-online.target dcar-api.service
Wants=network-online.target dcar-api.service

[Service]
Type=simple
User=dcar-aigc
Group=dcar-aigc
WorkingDirectory=/var/www/dcar-aigc/current/app/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=DCAR_WEB_BASE_PATH=/dcar
Environment=NEXT_PUBLIC_DCAR_API_BASE=/dcar
Environment=WRANGLER_WRITE_LOGS=false
Environment=WRANGLER_LOG_PATH=/tmp/dcar-wrangler.log
Environment=MINIFLARE_REGISTRY_PATH=/tmp/dcar-miniflare-registry
ExecStart=/var/www/dcar-aigc/runtime/node-v22.13.1-linux-x64/bin/node ./node_modules/vinext/dist/cli.js start --hostname 127.0.0.1 --port 4173
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0027

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

CPUQuota=100%
MemoryMax=1G
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
