[Unit]
Description=DcarAIGC authentication gateway
After=network-online.target dcar-api.service dcar-web.service
Wants=network-online.target dcar-api.service dcar-web.service
ConditionFileNotEmpty=/etc/nginx/.htpasswd-dcar
ConditionPathIsDirectory=/var/lib/dcar-aigc/auth

[Service]
Type=simple
User=dcar-aigc
Group=dcar-aigc
WorkingDirectory=/var/www/dcar-aigc/current
Environment=PYTHONPATH=/var/www/dcar-aigc/current/src/dcar_eval
Environment=DCAR_AUTH_BASE_PATH=/dcar
Environment=DCAR_AUTH_WEB_UPSTREAM=http://127.0.0.1:4174
Environment=DCAR_AUTH_API_UPSTREAM=http://127.0.0.1:8765
Environment=DCAR_AUTH_HTPASSWD=/etc/nginx/.htpasswd-dcar
Environment=DCAR_AUTH_SESSION_DB=/var/lib/dcar-aigc/auth/sessions.sqlite3
Environment=DCAR_AUTH_LOGIN_TEMPLATE=/var/www/dcar-aigc/current/deploy/server/nginx/login.html
Environment=DCAR_AUTH_SECURE_COOKIE=1
ExecStart=/var/www/dcar-aigc/current/.venv/bin/python -m uvicorn dcar_auth.gateway:app --app-dir /var/www/dcar-aigc/current/src/dcar_eval --host 127.0.0.1 --port 4173 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

ReadWritePaths=/var/lib/dcar-aigc/auth
ReadOnlyPaths=/etc/nginx/.htpasswd-dcar
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true

CPUQuota=100%
MemoryMax=512M
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
