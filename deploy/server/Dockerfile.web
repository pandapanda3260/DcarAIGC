FROM node:22.13.1-bookworm-slim AS build

WORKDIR /app

COPY app/web/package.json app/web/package-lock.json ./
RUN npm ci

COPY app/web/ ./
# The preview imports this public taxonomy outside the flattened web root.
COPY config/business_selling_points_v5_3.json /config/business_selling_points_v5_3.json

ARG DCAR_WEB_BASE_PATH=""
ARG NEXT_PUBLIC_DCAR_API_BASE=""

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    DCAR_WEB_BASE_PATH=${DCAR_WEB_BASE_PATH} \
    NEXT_PUBLIC_DCAR_API_BASE=${NEXT_PUBLIC_DCAR_API_BASE} \
    WRANGLER_WRITE_LOGS=false

RUN node ./node_modules/vinext/dist/cli.js build

FROM node:22.13.1-bookworm-slim AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=4174 \
    WRANGLER_WRITE_LOGS=false

WORKDIR /app

COPY --from=build --chown=node:node /app/package.json /app/package.json
COPY --from=build --chown=node:node /app/node_modules /app/node_modules
COPY --from=build --chown=node:node /app/dist /app/dist

USER node:node

EXPOSE 4174

CMD ["node", "./node_modules/vinext/dist/cli.js", "start", "--hostname", "0.0.0.0", "--port", "4174"]
