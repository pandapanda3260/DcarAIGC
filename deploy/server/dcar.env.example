DCAR_V8_DB=/var/www/dcar-aigc/current/app/data/dcar_insight.sqlite3
DCAR_LEGACY_DB=/var/www/dcar-aigc/current/app/data/web_mvp.sqlite3
DCAR_V8_REPORTS_ROOT=/var/www/dcar-aigc/current/reports/runs/v8
DCAR_OPERATOR_FREEZE_LOCK=/var/lib/dcar-aigc/runtime/operator-freeze.lock
DCAR_READ_ONLY=1
DCAR_SCHEDULER_ENABLED=0
DCAR_STARTUP_CATCHUP_ENABLED=0

# Only a designated writer host may set provider credentials. The online read
# replica must leave these unset while its scheduler and catch-up remain off.
# TIKHUB_API_KEY_FILE=/etc/dcar-aigc/credentials/tikhub.env
