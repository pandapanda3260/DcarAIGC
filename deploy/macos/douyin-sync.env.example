# Copy this file outside the repository to:
#   ~/Library/Application Support/DcarAIGC/douyin-sync.env
# Protect it with mode 0400 or 0600. Unknown or duplicate entries are rejected.

# Dedicated ~/.ssh/config alias. It must resolve to User dcar-douyin-sync and
# a dedicated private IdentityFile. Do not use the publisher alias.
DCAR_DOUYIN_SSH_ALIAS=dcar-douyin-sync-prod

# Fixed loopback port used by the Mac-side sync process. The remote destination
# remains exactly 127.0.0.1:4175 and cannot be changed from this file.
DCAR_DOUYIN_LOCAL_PORT=14175

# Absolute project-external file containing only the Machine credential.
DCAR_DOUYIN_MACHINE_KEY_FILE=/absolute/path/outside/the/repository/douyin-machine-key
