# Copy this file outside the repository to:
#   ~/Library/Application Support/DcarAIGC/writer.env
# Then replace the absolute key-file path and chmod the file to 0600.
# TikHub base and key remain in the external config file; never paste them here.
TIKHUB_API_KEY_FILE=/absolute/path/outside/the/repository/dcar.env.local

# After approval, set this to the exact acknowledgement printed in README.md.
# It is intentionally blank so copying this example cannot authorize spend.
# The current daily_capture hard ceiling is USD 20.
DCAR_DAILY_COST_AUTHORIZATION=
