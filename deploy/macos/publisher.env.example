# Copy this file outside the repository to:
#   ~/Library/Application Support/DcarAIGC/publisher.env
# Protect it with mode 0600. It contains deployment coordinates, never a
# password, private key, provider key, or BasicAuth credential.

# Dedicated alias from ~/.ssh/config. Do not use user@host or a raw IP here.
DCAR_PUBLISH_SSH_ALIAS=dcar-prod
DCAR_PUBLISH_REMOTE_PROJECT_ROOT=/var/www/dcar-aigc/current
DCAR_PUBLISH_REMOTE_STATE_ROOT=/var/lib/dcar-aigc
DCAR_PUBLISH_REMOTE_PYTHON=/var/www/dcar-aigc/current/.venv/bin/python

# Absolute local directory outside the repository. Snapshots and receipts are
# retained here even when a remote operation fails.
DCAR_PUBLISH_SNAPSHOT_ROOT=/absolute/path/outside/the/repository/DcarSnapshots

# At least 1 GiB. Five GiB is the documented default reserve. Each publication
# uses a new incoming/<snapshot-id> staging tree; it never overwrites the active
# artifact roots. The rehearsed manifest currently references 40,739,188,944
# artifact bytes, before the database bundle and reserve. The publisher also
# parses rsync --dry-run --stats for artifacts and bundle before transferring.
DCAR_PUBLISH_MIN_REMOTE_FREE_BYTES=5368709120
DCAR_PUBLISH_EXPECTED_USER_VERSION=13

# At 09:00, the newest published content must be no older than yesterday.
DCAR_PUBLISH_MAX_CONTENT_LAG_DAYS=1
